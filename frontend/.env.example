# SmartPR frontend environment variables (copy to .env.local and fill in).

# --- Supabase auth (client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Database (server) ---
# Pooled connection preferred; DIRECT_URL used as a fallback.
DATABASE_URL=
DIRECT_URL=

# --- Requirement monitoring/discovery admin gate ---
# Comma-separated allowlist of admin emails who can see the "Admin" entry point
# and run discovery/monitoring or approve requirements.
# OPEN DEFAULT: if unset/empty, ANY signed-in user is treated as an admin. Set
# this to lock access down to specific accounts.
ADMIN_EMAILS=

# Shared secret for the cron-compatible monitoring endpoint
# (POST/GET /api/requirements/monitor with header `x-cron-secret: <value>`).
REQUIREMENT_MONITOR_CRON_SECRET=

# --- Regulatory Knowledge Graph admin (/admin/knowledge-base) ---
# Direct xAI document intelligence and regulatory-source extraction (server only):
#   XAI_API_KEY=             (no key = deterministic flag-for-review fallback)
#   XAI_MODEL=               (default grok-4.3)
#   XAI_BASE_URL=            (default https://api.x.ai/v1)
# Scheduled publication batches publish on the next admin visit after their
# effective time, or wire a cron to GET /api/rk/batches (admin session) —
# no extra secret needed.

# --- Government artifact template library (scripts/sync-template-library.ts) ---
# Canonical form originals (official-form-templates/, municipal-form-templates/)
# are uploaded ONLY by this offline script, using the service role key (the
# anon key cannot write there and the running app never touches these
# buckets at request time — see forms/artifacts/templateLoader.ts). Uploads
# are write-once: an existing canonical object is never replaced.
SUPABASE_SERVICE_ROLE_KEY=

# --- Per-user storage buckets (evidence/, deliverables/, generated-filings/) ---
# Written directly by signed-in users' own sessions (never the service role
# key), so each bucket needs the RLS policy in
# data/compliance_workspace_schema.sql applied once against the Supabase
# project — run that file's trailing DO $$ ... $$ blocks (or the whole file)
# in the Supabase SQL editor. Without it, Storage's default-deny RLS blocks
# every read/write to these buckets even though the app-layer code is ready.
# --- Stripe (SmartPR billing) ---
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — omit to use test-mode defaults from catalog.ts
STRIPE_PRICE_FREE_MONTHLY=price_1UD5AgHS9D3i7NQZhu1XOOhl
STRIPE_PRICE_CORE_MONTHLY=price_1UD5AlHS9D3i7NQZWOYhVoY2
STRIPE_PRICE_CORE_YEARLY=price_1UD5AlHS9D3i7NQZNzSyMOmn
STRIPE_PRICE_OPERATOR_MONTHLY=price_1UD5AlHS9D3i7NQZiAjF4hvs
STRIPE_PRICE_OPERATOR_YEARLY=price_1UD5AlHS9D3i7NQZPp2dMG2u
STRIPE_PRICE_PARTNER_MONTHLY=price_1UD5AlHS9D3i7NQZwMoJMJtV
STRIPE_PRICE_PARTNER_YEARLY=price_1UD5AmHS9D3i7NQZAi0q065Y
STRIPE_PRICE_PILOT_ONE_TIME=price_1UD5AmHS9D3i7NQZhqshuOXp

# --- Google Analytics 4 ---
# GA4 measurement ID (G-XXXXXXXXXX) from analytics.google.com. When set,
# every page view (including SPA navigations) is sent to GA4; when unset,
# no analytics scripts load at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Deployment mode (SmartPR Standard vs SmartPR Enterprise) ---
# Parsed by src/lib/config/deployment.ts. NOT YET READ BY ANY RUNTIME CODE —
# leave these unset. Unset = today's Standard deployment (Supabase database,
# storage and auth; direct model access). Standard never needs these.
# Enterprise mode fails closed: every value below must be set explicitly.
# See docs/enterprise-azure/current-state-audit.md.
# DEPLOYMENT_MODE=           # standard | enterprise (default: standard)
# CUSTOMER_ID=               # enterprise only; lowercase slug
# CLOUD_PROVIDER=            # azure (required in enterprise)
# DATABASE_PROVIDER=         # supabase | azure-postgres
# STORAGE_PROVIDER=          # supabase | azure-blob
# AUTH_PROVIDER=             # supabase | entra
# MODEL_GATEWAY=             # direct | azure-foundry

# --- Passport locations: map + geocoding (see docs/passport-locations.md) ---
# Basemap style for the interactive Puerto Rico map (MapLibre GL). Public by
# design (a style URL, not a secret). Default: OpenFreeMap "liberty" (no key).
# Use a provider style URL that embeds a *browser-restricted* public key if
# you switch to MapTiler/Stadia/etc.
NEXT_PUBLIC_MAP_STYLE_URL=
# Address search / reverse geocoding (server-side only). Default: OSMF's
# public Nominatim, throttled to 1 request/second per process and cached, per
# its usage policy — fine for low volume. For higher traffic set
# MAP_GEOCODING_BASE_URL to a self-hosted or commercial Nominatim-compatible
# API (LocationIQ, etc.). MAP_GEOCODING_PROVIDER=off disables lookups (users
# then place the pin on the map or type coordinates).
MAP_GEOCODING_PROVIDER=
MAP_GEOCODING_BASE_URL=
MAP_GEOCODING_API_KEY=
MAP_GEOCODING_USER_AGENT=
MAP_GEOCODING_EMAIL=
