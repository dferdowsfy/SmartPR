{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartpr.app/schemas/clara-skill.schema.json",
  "title": "Clara filing skill",
  "description": "A reusable agency-portal filing skill: steps, field-to-passport mappings, conditional branches and declared human gates. Structure only — a skill never stores entered values, credentials or PII. Values come from the Business Passport at replay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "skillId",
    "version",
    "status",
    "scope",
    "portal",
    "form",
    "provenance",
    "gates",
    "rules",
    "steps"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "skillId": {
      "type": "string",
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$",
      "description": "<agency>.<form>, e.g. ogpe.permiso_unico. The file name is <skillId>.v<version>.json."
    },
    "version": { "type": "integer", "minimum": 1 },
    "status": {
      "enum": ["draft", "in_review", "active", "needs_reteach", "retired"]
    },
    "scope": { "enum": ["private", "shared"] },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agencyId", "name", "domains", "startUrl"],
      "properties": {
        "agencyId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" }
        },
        "startUrl": { "type": "string", "pattern": "^https://" }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filingTypeId", "label_en", "label_es"],
      "properties": {
        "filingTypeId": { "type": "string", "minLength": 1 },
        "label_en": { "type": "string", "minLength": 1 },
        "label_es": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "derivedFrom", "createdAt", "verification"],
      "properties": {
        "source": { "enum": ["hand_written", "teach_session"] },
        "derivedFrom": { "type": "string", "minLength": 1 },
        "createdAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "checkedAt", "evidence"],
          "properties": {
            "status": {
              "enum": ["observed", "partially_observed", "unobserved"]
            },
            "checkedAt": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "evidence": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "passportPath": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9]*)+$"
    },
    "gateKind": {
      "enum": [
        "login",
        "mfa",
        "captcha",
        "certification",
        "signature",
        "payment",
        "final_submit",
        "upload",
        "phone_call",
        "unknown_screen"
      ]
    },
    "evidence": {
      "enum": ["live_verified", "live_qa", "official_manual", "inferred"]
    },
    "bilingualText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "es"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "es": { "type": "string", "minLength": 1 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actor", "channel", "clara", "handoff"],
      "properties": {
        "kind": { "$ref": "#/$defs/gateKind" },
        "actor": {
          "const": "human",
          "description": "Every declared gate is performed by the human. Clara never acts at a gate."
        },
        "channel": { "enum": ["IN_BROWSER", "INLINE"] },
        "clara": {
          "enum": ["pause_and_handoff", "refuse_and_handoff", "pause_and_ask"],
          "description": "What Clara does when the gate appears. refuse_and_handoff is for acts she must decline even if asked (certification, signature, payment, final submit)."
        },
        "stepIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "description": "Steps where this gate is known to appear. Empty means the gate is a standing rule that applies wherever the portal shows it."
        },
        "handoff": { "$ref": "#/$defs/bilingualText" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": ["sequencing", "control_quirk", "choice", "safety"]
        },
        "text": { "$ref": "#/$defs/bilingualText" },
        "source": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label_es"],
      "properties": {
        "label_es": { "type": "string", "minLength": 1 },
        "label_en": { "type": "string", "minLength": 1 },
        "selector": {
          "type": ["string", "null"],
          "description": "CSS selector observed during a teach session. null when not yet observed — replay locates the control by label."
        },
        "control": {
          "enum": [
            "text",
            "email",
            "tel",
            "native_select",
            "custom_dropdown",
            "radio",
            "checkbox",
            "button",
            "link",
            "map",
            "file"
          ]
        },
        "role": {
          "enum": ["navigation", "save_draft", "next", "choice", "final_submit"],
          "description": "Semantic role. final_submit may only appear on human-actor steps."
        }
      }
    },
    "fillSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "passport" },
            "path": { "$ref": "#/$defs/passportPath" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ask"],
          "properties": {
            "kind": { "const": "ask_human" },
            "ask": { "$ref": "#/$defs/bilingualText" }
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target", "source", "required"],
          "properties": {
            "type": { "const": "fill" },
            "target": { "$ref": "#/$defs/target" },
            "source": { "$ref": "#/$defs/fillSource" },
            "required": { "type": "boolean" },
            "ruleIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target", "option"],
          "properties": {
            "type": { "const": "choose" },
            "target": { "$ref": "#/$defs/target" },
            "option": {
              "type": "string",
              "minLength": 1,
              "description": "Visible option text of the portal control — structure, never user data."
            },
            "ruleIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target"],
          "properties": {
            "type": { "const": "click" },
            "target": { "$ref": "#/$defs/target" },
            "ruleIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }
          }
        }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passportPath", "op"],
      "properties": {
        "passportPath": { "$ref": "#/$defs/passportPath" },
        "op": { "enum": ["exists", "missing", "equals", "not_equals", "in"] },
        "value": { "type": ["string", "number", "boolean"] },
        "values": { "type": "array", "items": { "type": "string" } }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "then"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "when": { "$ref": "#/$defs/condition" },
        "then": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gotoStepId": { "$ref": "#/$defs/id" },
            "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
            "pause": { "$ref": "#/$defs/bilingualText" }
          }
        },
        "note": { "type": "string" }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on", "do", "message"],
      "properties": {
        "on": {
          "enum": [
            "selector_miss",
            "unknown_screen",
            "validation_error",
            "empty_options",
            "unmapped_field",
            "gate_detected",
            "timeout"
          ]
        },
        "do": {
          "enum": ["relocate_by_label", "pause_and_ask", "handoff_to_human", "report_and_stop"],
          "description": "relocate_by_label is the only non-pausing fallback, and must be followed by a pausing fallback for the same trigger."
        },
        "message": { "$ref": "#/$defs/bilingualText" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label_en",
        "label_es",
        "actor",
        "channel",
        "screen",
        "observed",
        "evidence",
        "actions",
        "fallbacks"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label_en": { "type": "string", "minLength": 1 },
        "label_es": { "type": "string", "minLength": 1 },
        "actor": { "enum": ["clara", "human"] },
        "channel": { "enum": ["AGENT", "INLINE", "VAULT", "IN_BROWSER"] },
        "gate": { "$ref": "#/$defs/gateKind" },
        "screen": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pageId"],
          "properties": {
            "pageId": { "type": "string", "minLength": 1 },
            "headingIncludes": { "type": "array", "items": { "type": "string" } },
            "urlIncludes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "observed": {
          "type": "boolean",
          "description": "true only when this screen was seen in a live run. Manual-derived or inferred steps are false."
        },
        "evidence": { "$ref": "#/$defs/evidence" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "branches": { "type": "array", "items": { "$ref": "#/$defs/branch" } },
        "fallbacks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fallback" }
        },
        "expectedState_en": { "type": "string" },
        "expectedState_es": { "type": "string" },
        "notes_en": { "type": "string" },
        "notes_es": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "actor": { "const": "human" } },
            "required": ["actor"]
          },
          "then": {
            "properties": { "actions": { "maxItems": 0 } }
          }
        },
        {
          "if": {
            "required": ["gate"],
            "properties": {
              "gate": {
                "enum": [
                  "login",
                  "mfa",
                  "captcha",
                  "certification",
                  "signature",
                  "payment",
                  "final_submit",
                  "phone_call"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "actor": { "const": "human" },
              "channel": { "const": "IN_BROWSER" }
            }
          }
        }
      ]
    }
  }
}
