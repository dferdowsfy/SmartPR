    "when": "[{\"fact_address\":\"profile:number_of_employees\",\"operator\":\"greater_than\",\"value\":0},{\"fact_address\":\"question:Q_EMPLOYEE_COUNT\",\"operator\":\"equals\",\"value\":\"0\"}]",
    "fact_ids": [
      "IF_profile__number_of_employees",
      "IF_question__Q_EMPLOYEE_COUNT"
    ]
  },
