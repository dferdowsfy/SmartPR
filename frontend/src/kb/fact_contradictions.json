  {
    "id": "CONTRA_EMPLOYEE_COUNT_VS_HIRING",
    "message": "A headcount above zero was given, but the intake also says no employees will be hired.",
    "when": "[{\"fact_address\":\"profile:number_of_employees\",\"operator\":\"greater_than\",\"value\":0},{\"fact_address\":\"question:Q_EMPLOYEES_HIRED\",\"operator\":\"equals\",\"value\":false}]",
    "fact_ids": [
      "IF_profile__number_of_employees",
      "IF_question__Q_EMPLOYEES_HIRED"
    ]
  },
  {
    "id": "CONTRA_EMPLOYEE_BUCKET_VS_COUNT",
